{
  "name": "openformatdb",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "validate": "npm run validate -w @openformatdb/core",
    "import": "npm run import -w @openformatdb/importers --",
    "test": "npm test --workspaces --if-present",
    "mcp": "npm run start -w @openformatdb/mcp",
    "build": "npm run build -w site",
    "dev": "npm run dev -w site"
  },
  "engines": {
    "node": ">=22.18"
  }
}
